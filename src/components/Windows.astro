---
import Arrow from './Arrow.astro';
const stages=[
 {name:'Fundações',when:'Antes da execução',title:'Estabelecer referências antes de executar.',text:'Locação de estacas e conferências de referência ajudam a relacionar projeto e campo. Com elementos executados e acessíveis, pode ser avaliada a conferência de excentricidade.',link:'/servicos/locacao-de-estacas/'},
 {name:'Estrutura',when:'Com referências acessíveis',title:'Documentar enquanto o objeto está acessível.',text:'Linhas de eixo orientam referências de execução. O as-built de laje protendida depende do objeto a registrar e da etapa em que ele está acessível.',link:'/servicos/as-built-de-laje-protendida/'},
 {name:'Instalações',when:'Antes dos fechamentos',title:'Registrar o visível antes de recobrir.',text:'O as-built MEP documenta as instalações abrangidas pelo escopo. A captura direta depende de visibilidade; elementos ocultos não são identificados pelo laser.',link:'/servicos/as-built-mep/'},
 {name:'Intervenção',when:'Antes da alteração',title:'Conhecer a condição antes de transformá-la.',text:'Levantamentos de interiores e escaneamentos de fachada registram condições existentes para apoiar projetos de reforma e retrofit.',link:'/servicos/levantamento-de-interiores/'}
];
---
<section class="windows-section" aria-labelledby="windows-title" id="janelas"><div class="windows-scroll" data-windows><div class="windows-visual"><div class="windows-heading"><h2 id="windows-title">A obra avança. O acesso muda.</h2><p>Antes de recobrir ou alterar, registre as condições acessíveis ao levantamento.</p></div><ol class="stage-controls" aria-label="Momentos da obra">{stages.map((s,i)=><li><button class="stage-button" data-stage={i} aria-pressed={i===0?'true':'false'} aria-controls={`stage-detail-${i}`}><span class="stage-number">{String(i+1).padStart(2,'0')}</span><strong>{s.name}</strong><span>{s.when}</span></button></li>)}</ol><figure><img class="construction-image" src="/images/construction-section.webp" width="2144" height="733" alt="Estudo conceitual em corte relacionando fundações, estrutura, instalações aparentes e representação geométrica." loading="eager"/><figcaption class="windows-caption">Estudo visual conceitual. Os momentos de contratação dependem do objeto, do acesso e do escopo.</figcaption></figure>{stages.map((s,i)=><div id={`stage-detail-${i}`} class="window-detail" data-stage-detail={i} hidden={i!==0}><strong>{s.title}</strong><p>{s.text}</p><a class="text-link" href={s.link}>Conhecer o serviço <Arrow/></a></div>)}</div></div></section>
<style>.window-detail[hidden]{display:none}</style>
