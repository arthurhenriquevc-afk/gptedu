---
import Arrow from './Arrow.astro';
// access: o que costuma estar acessível no momento; links: todos os serviços ligados a ele.
const stages=[
 {name:'Fundações',when:'Antes da execução',title:'Estabelecer referências antes de executar.',access:'O terreno preparado e as referências de projeto; depois, as marcações e as estacas executadas, antes do recobrimento.',links:[['Locação das linhas de eixo das estacas','/servicos/locacao-das-linhas-de-eixo-das-estacas/'],['Conferência da excentricidade das estacas','/servicos/conferencia-da-excentricidade-das-estacas/']]},
 {name:'Estrutura',when:'Com elementos acessíveis',title:'Documentar enquanto o objeto está acessível.',access:'Os elementos da laje visíveis na etapa definida para o registro.',links:[['As-built de laje protendida','/servicos/as-built-de-laje-protendida/']]},
 {name:'Instalações',when:'Antes dos fechamentos',title:'Registrar o visível antes de recobrir.',access:'Tubulações, eletrodutos e dutos aparentes, antes de forros e paredes; elementos ocultos não são identificados pelo laser.',links:[['As-built e infraestrutura MEP','/servicos/as-built-mep/']]},
 {name:'Intervenção',when:'Antes da alteração',title:'Conhecer a condição antes de transformá-la.',access:'Fachadas e ambientes existentes, antes de demolições e alterações.',links:[['Escaneamento de fachada','/servicos/escaneamento-de-fachada/'],['Levantamento de interiores','/servicos/levantamento-de-interiores/']]}
];
---
<section class="windows-section" aria-labelledby="windows-title" id="janelas"><div class="windows-scroll" data-windows><div class="windows-visual"><div class="windows-heading"><h2 id="windows-title">A obra avança. O acesso muda.</h2><p>Antes de recobrir ou alterar, registre as condições acessíveis ao levantamento.</p></div><ol class="stage-controls" aria-label="Momentos da obra">{stages.map((s,i)=><li><button class="stage-button" data-stage={i} aria-pressed={i===0?'true':'false'} aria-controls={`stage-detail-${i}`}><span class="stage-number">{String(i+1).padStart(2,'0')}</span><strong>{s.name}</strong><span>{s.when}</span></button></li>)}</ol><figure><img class="construction-image" src="/images/construction-section.webp" width="2144" height="733" alt="Estudo conceitual em corte relacionando fundações, estrutura, instalações aparentes e representação geométrica." loading="eager"/><figcaption class="windows-caption">Estudo visual conceitual. Os momentos de contratação dependem do objeto, do acesso e do escopo. Conferência de topografia, mapeamento com drone e tour virtual seguem a finalidade, não uma etapa.</figcaption></figure>{stages.map((s,i)=><div id={`stage-detail-${i}`} class="window-detail" data-stage-detail={i} hidden={i!==0}><strong>{s.title}</strong><p><span class="window-access">Acessível nesta etapa</span>{s.access}</p><ul class="window-links">{s.links.map(([label,href])=><li><a class="text-link" href={href}>{label} <Arrow/></a></li>)}</ul></div>)}</div></div></section>
<style>.window-detail[hidden]{display:none}</style>
