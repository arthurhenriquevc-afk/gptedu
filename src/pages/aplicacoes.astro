---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import ContactCTA from '../components/ContactCTA.astro';
const applications=[
 {title:'Registrar instalações antes de fechar.',context:'Infraestrutura predial',text:'Com instalações aparentes, um registro pode preservar informações das condições acessíveis para consultas e intervenções futuras.',scope:'Definir sistemas, áreas, acesso e a relação entre captura direta e documentos complementares.',service:'as-built-mep',label:'As-built e infraestrutura MEP'},
 {title:'Projetar a partir do ambiente existente.',context:'Arquitetura e interiores',text:'Antes de uma reforma, o levantamento pode organizar referências dimensionais para compreender a configuração do espaço.',scope:'Definir ambientes, elementos relevantes e materiais que apoiam o desenvolvimento do projeto.',service:'levantamento-de-interiores',label:'Levantamento arquitetônico de interiores'},
 {title:'Relacionar fundações executadas ao projeto.',context:'Conferência geométrica',text:'Uma comparação de posições pode fornecer informações aos profissionais responsáveis pela análise da execução.',scope:'Alinhar referências, elementos e acesso. Critérios de aceitação e conclusões estruturais não são presumidos.',service:'conferencia-de-excentricidade',label:'Conferência de excentricidade das estacas'},
 {title:'Entender a geometria antes do retrofit.',context:'Fachada existente',text:'A captura de superfícies visíveis pode apoiar a leitura geométrica da fachada antes de uma intervenção.',scope:'Definir superfícies abrangidas, restrições de visibilidade e os materiais necessários ao projeto.',service:'escaneamento-de-fachada',label:'Escaneamento de fachada para retrofit'}
];
---
<Layout title="Aplicações" description="Exemplos conceituais de como documentação, levantamentos e conferências podem apoiar projetos e obras."><section class="page-opening section"><nav class="breadcrumb" aria-label="Caminho da página"><a href="/">Início</a><span aria-hidden="true">/</span><span aria-current="page">Aplicações</span></nav><h1>O uso da informação<br/>é o ponto de partida.</h1><p>Quatro situações para relacionar uma necessidade ao serviço pertinente.</p><span class="concept-label">Exemplos conceituais. Não são cases executados.</span></section><section class="section" style="padding-top:0">{applications.map(a=><article class="application-entry"><div><span>{a.context}</span><h2>{a.title}</h2><p>{a.text}</p></div><div><h3>O que precisa ser alinhado</h3><p>{a.scope}</p><a class="text-link" href={`/servicos/${a.service}/`}>{a.label} <Arrow/></a></div></article>)}</section><ContactCTA title="Qual informação falta no seu projeto?"/></Layout>
