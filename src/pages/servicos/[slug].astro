---
import Layout from '../../layouts/Layout.astro';
import Arrow from '../../components/Arrow.astro';
import FAQ from '../../components/FAQ.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { services, audienceLabel, goalLabel, type Service } from '../../data/services';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
interface Props { service: Service; }
const {service:s}=Astro.props;
const bySlug=(slug:string)=>services.find(item=>item.slug===slug)!;
const related=s.related.map(([slug,why])=>({item:bySlug(slug),why}));
// Comparação gerada dos mesmos campos dos dois serviços, para não criar diferenças que os dados não sustentam.
const other=s.compare?bySlug(s.compare):undefined;
const compareRows:[string,keyof Service][]=[['Pergunta que responde','question'],['Momento','moment'],['Precisa estar acessível','access']];
// Etapa do corte da Home relacionada a cada serviço (índice dos momentos em Windows.astro); sem entrada, abre em Fundações.
const windowStage: Record<string,number> = {'locacao-de-linhas-de-eixo':1,'as-built-de-laje-protendida':1,'as-built-mep':2,'levantamento-de-interiores':3,'escaneamento-de-fachada':3};
const windowsHref=s.slug in windowStage?`/?etapa=${windowStage[s.slug]+1}#janelas`:'/#janelas';
const ctaTitles: Record<string,string> = {'conferencia-de-topografia':'Quais referências você precisa conferir?','mapeamento-aereo-com-drone':'Qual área precisa de uma leitura aérea?','locacao-de-estacas':'Prepare as referências para a etapa de fundações.','locacao-de-linhas-de-eixo':'Defina as referências da próxima execução.','conferencia-de-excentricidade':'Vamos alinhar a conferência dos elementos executados?','as-built-de-laje-protendida':'O que precisa ficar documentado da laje?','as-built-mep':'Planeje o registro antes dos fechamentos.','escaneamento-de-fachada':'Comece o retrofit pela condição existente.','levantamento-de-interiores':'Conte o que você vai projetar neste espaço.','tour-virtual-decorado':'Como você precisa apresentar o ambiente?'};
const image=s.image==='interior'?'/images/interior.webp':'/images/hero-scan.webp';
const contactHref=`/contato/?servico=${s.slug}`;
---
<Layout title={s.name} description={s.summary}>
<section class="page-opening section"><nav class="breadcrumb" aria-label="Caminho da página"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/servicos/">Serviços</a><span aria-hidden="true">/</span><a href={`/servicos/${s.audience}/`}>{audienceLabel(s.audience)}</a><span aria-hidden="true">/</span><span aria-current="page">{s.name}</span></nav><h1>{s.headline}</h1><h2 class="service-title">{s.name}</h2><p>{s.summary}</p><div class="actions"><a class="button" href={contactHref}>Conversar sobre este serviço <Arrow/></a><a class="text-link" href="#entregaveis">Entender os entregáveis</a></div></section>
<dl class="service-facts" aria-label="Resumo do serviço"><div><dt>Pergunta que responde</dt><dd>{s.question}</dd></div><div><dt>Momento</dt><dd>{s.moment}</dd></div><div><dt>Precisa estar acessível</dt><dd>{s.access}</dd></div><div><dt>Finalidade</dt><dd>{goalLabel(s.goal)}<span>{audienceLabel(s.audience)}</span></dd></div></dl>
<figure class="wide-image"><img src={image} width={s.image==='interior'?1536:2143} height={s.image==='interior'?1024:734} alt={s.image==='interior'?'Estudo conceitual de ambiente interior.':'Estudo conceitual de estrutura e representação geométrica.'} fetchpriority="high"/><figcaption>Imagem conceitual de contexto. Não representa execução, resultado técnico ou projeto da UNION3D.</figcaption></figure>
<div class="service-content section"><aside aria-label="Nesta página"><h2>Neste serviço</h2><a href="#finalidade">Finalidade</a><a href="#quando">Quando contratar</a>{s.sources&&<a href="#alcance">O que o registro alcança</a>}<a href="#execucao">Execução</a><a href="#entregaveis">Entregáveis</a>{other&&<a href="#comparacao">Não confundir</a>}<a href="#solicitacao">O que informar</a><a href="#duvidas">Dúvidas</a></aside><div>
<section class="content-section" id="finalidade"><h2>O que este serviço faz.</h2><p>{s.purpose}</p><p>{s.benefit}</p></section>
<section class="content-section" id="quando"><h2>Quando faz sentido contratar.</h2><p>{s.timing}</p><ul>{s.situations.map(item=><li>{item}</li>)}</ul><a class="text-link" href={windowsHref}>Relacionar à etapa da obra <Arrow/></a></section>
{s.sources&&<section class="content-section" id="alcance"><h2>O que o registro alcança.</h2><p>Na entrega, o que foi capturado em campo precisa aparecer separado do que vem de documentos ou de outras fontes.</p><div class="source-columns"><div><h3>Captura direta</h3><ul>{s.sources.direct.map(item=><li>{item}</li>)}</ul></div><div><h3>Depende de outras fontes</h3><ul>{s.sources.other.map(item=><li>{item}</li>)}</ul></div></div></section>}
<section class="content-section" id="execucao"><h2>Da necessidade ao registro.</h2><p>O planejamento começa pela finalidade e pelas informações disponíveis. A execução específica é alinhada antes da contratação.</p><ol class="execution-list">{s.process.map(([title,text])=><li><strong>{title}</strong><span>{text}</span></li>)}</ol></section>
<section class="content-section" id="entregaveis"><h2>Entregáveis definidos pelo uso.</h2><p>Possibilidades a confirmar no escopo de cada contratação, não um pacote fixo.</p><ul>{s.deliverables.map(item=><li>{item}</li>)}</ul><p class="scope-note"><strong>Limites e pontos a alinhar</strong>{s.limitation}</p></section>
{other&&<section class="content-section" id="comparacao"><h2>Não confundir com {other.name[0].toLocaleLowerCase('pt-BR')+other.name.slice(1)}.</h2><p>Os dois serviços costumam aparecer juntos na mesma conversa. A diferença está na pergunta, no momento e no que precisa estar acessível.</p><table class="compare-table"><caption class="visually-hidden">Comparação entre {s.name} e {other.name}</caption><thead><tr><td></td><th scope="col">{s.name}</th><th scope="col"><a href={`/servicos/${other.slug}/`}>{other.name}</a></th></tr></thead><tbody>{compareRows.map(([label,key])=><tr><th scope="row">{label}</th><td data-label={s.name}>{s[key] as string}</td><td data-label={other.name}>{other[key] as string}</td></tr>)}</tbody></table></section>}
<section class="content-section" id="solicitacao"><h2>O que ajuda a começar.</h2><p>Itens úteis para a primeira conversa. Não é necessário reunir todos antes de entrar em contato.</p><ul class="checklist">{s.checklist.map(item=><li>{item}</li>)}</ul><a class="text-link" href={contactHref}>Preparar uma solicitação <Arrow/></a></section>
<div class="content-section" id="duvidas"><FAQ title="Dúvidas sobre esta atividade." items={s.faq}/></div>
</div></div>
<section class="related section"><div class="section-heading"><h2>Outras informações que podem se complementar.</h2><p>A relação depende da finalidade, da etapa e dos elementos abrangidos pelo projeto.</p></div><div class="service-list service-list-question">{related.map(({item,why})=><a class="service-row" href={`/servicos/${item.slug}/`}><span class="service-audience">{goalLabel(item.goal)}</span><div><h3>{item.name}</h3><p>{why}</p></div><Arrow/></a>)}</div></section>
<ContactCTA title={ctaTitles[s.slug]} service={s.slug}/>
</Layout>
