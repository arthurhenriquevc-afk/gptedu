---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Windows from '../components/Windows.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GoalFinder from '../components/GoalFinder.astro';
import RealCapture from '../components/RealCapture.astro';
import { faqs,workflow } from '../data/services';
// Situações concretas que levam a um serviço; descrevem a pergunta do visitante, não um resultado prometido.
const situations:[string,string,string][]=[
 ['As instalações vão ser fechadas e ninguém registrou por onde passam.','As-built e infraestrutura MEP','/servicos/as-built-mep/'],
 ['As estacas foram executadas e a equipe precisa saber se estão onde o projeto previa.','Conferência de excentricidade','/servicos/conferencia-de-excentricidade/'],
 ['A fachada vai passar por retrofit e os desenhos disponíveis não mostram o que existe hoje.','Escaneamento de fachada','/servicos/escaneamento-de-fachada/'],
 ['O apartamento vai ser projetado e não há uma planta confiável do espaço.','Levantamento de interiores','/servicos/levantamento-de-interiores/']
];
---
<Layout>
<section class="hero" aria-labelledby="hero-title" data-hero><div class="hero-media"><img src="/images/hero-physical.webp" width="2143" height="734" alt="Estudo conceitual de uma estrutura de concreto em construção." fetchpriority="high"/><img class="scan-image" src="/images/hero-scan.webp" width="2143" height="734" alt="" aria-hidden="true" fetchpriority="high"/></div><div class="hero-copy"><h1 id="hero-title"><span>Antes de decidir,</span><span>registre o que existe.</span></h1><p>Escaneamento a laser 3D, levantamentos e conferências para orientar projetos e obras.</p><div class="actions"><a class="button" href="/contato/">Solicitar orçamento <Arrow/></a><a class="button button-outline" href="/servicos/">Explorar serviços</a></div></div><p class="hero-caption">Estudo visual conceitual. Não representa obra da UNION3D.</p><label class="scan-control">Espaço físico <input type="range" min="0" max="100" value="55" aria-label="Comparar espaço físico e representação geométrica" data-scan-control/> Representação</label></section>
<Windows/>
<div class="credibility" aria-label="Atuação e método"><div><strong>Construção civil</strong><span>Conferência e documentação</span></div><div><strong>Arquitetura e interiores</strong><span>Informações para projetar</span></div><div><strong>Captura da realidade</strong><span>Escaneamento a laser 3D</span></div><div><strong>Santa Catarina</strong><span>Contexto de atuação</span></div></div>
<section class="intro section"><h2>O espaço físico tem informações que o projeto precisa conhecer.</h2><div><p>A UNION3D registra, documenta e confere condições de ambientes e elementos construtivos. Dados de campo ajudam a relacionar o que foi projetado ao que existe.</p><p>O valor está na aplicação: compreender um ambiente, conferir uma referência ou preservar uma condição antes que ela mude.</p><a class="text-link" href="/sobre/">Conhecer a UNION3D <Arrow/></a></div></section>
<section class="audiences section" aria-label="Dois universos de atuação"><article class="audience-block"><figure><img src="/images/hero-scan.webp" alt="Estudo conceitual de estrutura e sua representação geométrica." width="2143" height="734" loading="lazy"/><figcaption>Estudo visual conceitual de aplicação à construção.</figcaption></figure><h2>Informação de campo para a próxima decisão da obra.</h2><span class="audience-label">Para empresas</span><p>Construtoras, incorporadoras e equipes de engenharia encontram serviços de locação, conferência e documentação de condições executadas.</p><a class="text-link" href="/servicos/empresas/">Serviços para empresas <Arrow/></a></article><article class="audience-block"><figure><img src="/images/interior.webp" alt="Estudo conceitual de interior com vãos amplos, superfícies claras e elementos em madeira." width="1536" height="1024" loading="lazy"/><figcaption>Estudo visual conceitual de ambiente interior.</figcaption></figure><h2>O existente como base para criar.</h2><span class="audience-label">Para profissionais</span><p>Arquitetos, designers e marcenarias podem registrar o espaço para desenvolver projetos ou explorar soluções de apresentação espacial.</p><a class="text-link" href="/servicos/profissionais/">Serviços para profissionais <Arrow/></a></article></section>
<GoalFinder/>
<section class="technology section"><div><h2>A tecnologia registra. A finalidade orienta.</h2><p>O escaneamento a laser 3D, com equipamento da linha FARO Focus 3D, captura superfícies visíveis. A nuvem de pontos representa essas condições no espaço digital.</p><p>Planejamento de campo, tratamento dos dados e definição da entrega fazem parte da relação entre instrumento e resultado. Cada serviço exige o método adequado ao seu objeto.</p><a class="text-link" href="/sobre/#tecnologia">Entender o método <Arrow/></a></div><ol class="technology-steps"><li><span>01</span><div><h3>Condição física</h3><p>O que existe, está acessível e precisa ser documentado.</p></div></li><li><span>02</span><div><h3>Captura e registro</h3><p>Procedimento alinhado ao objeto e às condições de campo.</p></div></li><li><span>03</span><div><h3>Dados organizados</h3><p>Tratamento das informações e preparação dos materiais previstos.</p></div></li><li><span>04</span><div><h3>Uso no projeto</h3><p>Documentação para as decisões e consultas definidas no escopo.</p></div></li></ol></section>
<RealCapture/>
<section class="method section"><div><h2>Clareza do primeiro contato à entrega.</h2><p>A necessidade do projeto vem antes da escolha do equipamento. O escopo conecta a atividade à informação que será utilizada.</p></div><ol>{workflow.map(([title,text],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<section class="applications-teaser section"><figure><img src="/images/interior.webp" width="1536" height="1024" alt="Ambiente interior conceitual, utilizado para ilustrar o registro do espaço antes de projetar." loading="lazy"/><figcaption>Imagem conceitual. Não representa projeto executado pela UNION3D.</figcaption></figure><div><h2>Da condição existente à aplicação no projeto.</h2><p>Necessidades diferentes pedem informações diferentes. Algumas situações que costumam iniciar uma conversa:</p><ul class="situation-list">{situations.map(([text,service,href])=><li><a href={href}><span>{text}</span><strong>{service} <Arrow/></strong></a></li>)}</ul><a class="text-link" href="/aplicacoes/">Explorar aplicações <Arrow/></a></div></section>
<FAQ items={faqs}/><ContactCTA/>
</Layout>
