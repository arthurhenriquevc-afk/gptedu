---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import Windows from '../components/Windows.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GoalFinder from '../components/GoalFinder.astro';
import RealCapture from '../components/RealCapture.astro';
import { faqs,workflow } from '../data/services';
// Problemas de obra e projeto adaptados das páginas de teste (docs/mapeamento-editorial-home.md); descrevem a situação, não um resultado prometido.
const problems:[string,string,string,string][]=[
 ['A parede aberta de novo.','Sem registro de por onde passam as instalações, localizar uma tubulação ou fixar um armário pode exigir abrir um acabamento pronto. O as-built feito antes do fechamento guarda a posição do que estava aparente.','As-built e infraestrutura MEP','/servicos/as-built-mep/'],
 ['A frente de serviço parada.','Uma estaca fora de posição percebida depois do bloco interrompe a sequência até a engenharia decidir. Conferida antes, a informação chega aos responsáveis enquanto ainda há tempo para decidir.','Conferência da excentricidade das estacas','/servicos/conferencia-da-excentricidade-das-estacas/'],
 ['A segunda visita ao imóvel.','Uma medida que faltou vira nova ida ao local e uma pausa no projeto. O escaneamento registra de uma vez o ambiente acessível, para consultar durante o desenvolvimento.','Levantamento arquitetônico de interiores','/servicos/levantamento-de-interiores/'],
 ['Desenhos que não mostram o edifício de hoje.','A fachada vai passar por retrofit e os documentos disponíveis não correspondem ao que existe. O registro da condição atual dá ao projeto uma base própria.','Escaneamento de fachada para retrofit','/servicos/escaneamento-de-fachada/']
];
// A FAQ da Home usa a redação das perguntas da referência; o contato continua com a lista geral de services.ts.
const general=(start:string)=>faqs.find(([q])=>q.startsWith(start))!;
const homeFaqs:[string,string][]=[
 general('Não sei qual serviço'),
 ['O que preciso enviar para pedir um orçamento?','Localização, área aproximada, tipo de ambiente ou etapa da obra e o uso previsto da informação. Plantas e outros documentos podem ser compartilhados depois; não é necessário ter tudo definido.'],
 ['Qual a diferença entre laser scanner e drone?','O laser scanner é posicionado em um tripé, em pontos do ambiente, e registra interiores, estruturas e detalhes. O drone registra terrenos e grandes áreas do alto e depende de condições de voo. Os dois métodos podem se complementar, conforme a finalidade.'],
 ['É preciso parar a obra durante o registro?','Depende da atividade e do que precisa ser registrado. O planejamento considera a rotina da obra, o acesso e a visibilidade, e a eventual liberação de uma área é combinada antes.'],
 general('Como os dados'),
 general('O laser registra')
];
---
<Layout>
<section class="hero" aria-labelledby="hero-title" data-hero><div class="hero-media"><img src="/images/hero-physical.webp" width="2143" height="734" alt="Estudo conceitual de uma estrutura de concreto em construção." fetchpriority="high"/><img class="scan-image" src="/images/hero-scan.webp" width="2143" height="734" alt="" aria-hidden="true" fetchpriority="high"/></div><div class="hero-copy"><h1 id="hero-title"><span>Antes de decidir,</span><span>registre o que existe.</span></h1><p>Escaneamento a laser 3D, <span class="nowrap">as-built</span>, levantamentos e conferências para orientar projetos e obras em Santa Catarina.</p><div class="actions"><a class="button" href="/contato/">Solicitar orçamento <Arrow/></a><a class="button button-outline" href="/servicos/">Explorar serviços</a></div></div><p class="hero-caption">Estudo visual conceitual. Não representa obra da UNION3D.</p><label class="scan-control">Espaço físico <input type="range" min="0" max="100" value="55" aria-label="Comparar espaço físico e representação geométrica" data-scan-control/> Representação</label></section>
<Windows/>
<div class="credibility" aria-label="Atuação e método"><div><strong>Construção civil</strong><span>Conferência e documentação</span></div><div><strong>Arquitetura e interiores</strong><span>Informações para projetar</span></div><div><strong>Captura da realidade</strong><span>Escaneamento a laser 3D</span></div><div><strong>Santa Catarina</strong><span>Contexto de atuação</span></div></div>
<section class="intro section"><h2>O espaço físico tem informações que o projeto precisa conhecer.</h2><div><p>A UNION3D registra, documenta e confere condições de ambientes e elementos construtivos. Dados de campo ajudam a relacionar o que foi projetado ao que existe.</p><p>O valor está na aplicação: compreender um ambiente, conferir uma referência ou preservar uma condição antes que ela mude. Um registro datado mostra o que estava visível naquele momento e dá à construtora, aos projetistas e às equipes de execução a mesma base para conversar.</p><a class="text-link" href="/sobre/">Conhecer a UNION3D <Arrow/></a></div></section>
<section class="audiences section" aria-label="Dois universos de atuação"><article class="audience-block"><figure><img src="/images/hero-scan.webp" alt="Estudo conceitual de estrutura e sua representação geométrica." width="2143" height="734" loading="lazy"/><figcaption>Estudo visual conceitual de aplicação à construção.</figcaption></figure><h2>Informação de campo para a próxima decisão da obra.</h2><span class="audience-label">Para empresas</span><p>Construtoras, incorporadoras e equipes de engenharia registram cada etapa antes que ela seja coberta e conferem posições em relação ao projeto, da locação das estacas ao <span class="nowrap">as-built</span> das instalações.</p><a class="text-link" href="/servicos/empresas/">Serviços para empresas <Arrow/></a></article><article class="audience-block"><figure><img src="/images/interior.webp" alt="Estudo conceitual de interior com vãos amplos, superfícies claras e elementos em madeira." width="1536" height="1024" loading="lazy"/><figcaption>Estudo visual conceitual de ambiente interior.</figcaption></figure><h2>Meça uma vez. Projete com o espaço registrado.</h2><span class="audience-label">Para profissionais</span><p>Arquitetos, designers e marcenarias registram o ambiente existente, com esquadros, prumos e alturas, para consultar durante o projeto. A apresentação espacial do ambiente é outra finalidade, com escopo próprio.</p><a class="text-link" href="/servicos/profissionais/">Serviços para profissionais <Arrow/></a></article></section>
<section class="problems section" aria-labelledby="problems-title"><div class="section-heading"><h2 id="problems-title">Problemas que começam quando ninguém mediu antes.</h2><p>Situações comuns em obra e projeto, cada uma ligada ao serviço que trata dela.</p></div><ul class="problem-list">{problems.map(([title,text,service,href])=><li><a href={href}><h3>{title}</h3><p>{text}</p><strong>{service} <Arrow/></strong></a></li>)}</ul><a class="text-link problems-more" href="/aplicacoes/">Explorar aplicações <Arrow/></a></section>
<GoalFinder/>
<section class="technology section"><div><h2>A tecnologia registra. A finalidade orienta.</h2><p>O escaneamento a laser 3D, com equipamento da linha FARO Focus 3D, captura superfícies visíveis. A nuvem de pontos representa essas condições no espaço digital. Para terrenos e grandes áreas abertas, o mapeamento aéreo usa drone.</p><p>Planejamento de campo, tratamento dos dados e definição da entrega fazem parte da relação entre instrumento e resultado. Cada serviço exige o método adequado ao seu objeto.</p><a class="text-link" href="/sobre/#tecnologia">Entender o método <Arrow/></a></div><ol class="technology-steps"><li><span>01</span><div><h3>Condição física</h3><p>O que existe, está acessível e precisa ser documentado.</p></div></li><li><span>02</span><div><h3>Captura e registro</h3><p>Procedimento alinhado ao objeto e às condições de campo.</p></div></li><li><span>03</span><div><h3>Dados organizados</h3><p>Tratamento das informações e preparação dos materiais previstos.</p></div></li><li><span>04</span><div><h3>Uso no projeto</h3><p>Documentação para as decisões e consultas definidas no escopo.</p></div></li></ol></section>
<RealCapture/>
<section class="method section"><div><h2>Clareza do primeiro contato à entrega.</h2><p>A necessidade do projeto vem antes da escolha do equipamento. O escopo conecta a atividade à informação que será utilizada.</p></div><ol>{workflow.map(([title,text],i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></section>
<FAQ items={homeFaqs}/><ContactCTA title="Diga em que ponto a obra ou o projeto está." text="Com a etapa, a localização e a informação de que você precisa, a conversa começa pelo escopo. Se a obra ainda vai começar, vale prever os registros desde o planejamento."/>
</Layout>
